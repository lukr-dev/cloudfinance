{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "vite-plus/client", "node"]
  },
  "include": [
    "src",
    "routes",
    "middleware",
    "crons",
    "queues",
    "db",
    "server",
    "shared",
    "tests",
    "*.ts"
  ]
}
