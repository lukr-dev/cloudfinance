{
  "name": "cloudfinance",
  "version": "0.0.0",
  "private": true,
  "description": "Single-user budgeting on Cloudflare; foundation only.",
  "keywords": [],
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check && vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "test": "vp test",
    "build": "vp build",
    "prepare": "void prepare",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "db:reset": "void db reset --yes",
    "deploy": "void deploy --platform cloudflare"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.10",
    "@better-auth/passkey": "^1.7.10",
    "better-auth": "^1.7.10",
    "hono": "^4.13.13",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "void": "1.1.11",
    "vue-tsc": "^3.3.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@12.14.0"
}
